# Traefik bootstrap values — hostname replaced at install time.
deployment:
  replicas: 1

ingressClass:
  enabled: false

ingressRoute:
  dashboard:
    enabled: true
    matchRule: Host(`@TRAEFIK_FQDN@`)
    entryPoints:
      - websecure

gateway:
  enabled: false

gatewayClass:
  enabled: false

providers:
  kubernetesCRD:
    enabled: true
    allowCrossNamespace: true
  kubernetesIngress:
    enabled: false
  kubernetesGateway:
    enabled: false

ports:
  web:
    port: 8000
    expose:
      default: true
    exposedPort: 80
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
      forwardedHeaders:
        insecure: true
  websecure:
    port: 8443
    expose:
      default: true
    exposedPort: 443
    http:
      tls:
        enabled: true
    forwardedHeaders:
      insecure: true

service:
  type: LoadBalancer

api:
  dashboard: true

log:
  level: INFO

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    cpu: 300m
    memory: 256Mi
