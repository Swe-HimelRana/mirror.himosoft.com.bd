terms_already_accepted() {
  [[ -f "${TERMS_FILE}" ]] || return 1
  # shellcheck source=/dev/null
  source "${TERMS_FILE}" 2>/dev/null || return 1
  [[ "${ACCEPTED_TERMS_VERSION:-}" == "${TERMS_VERSION}" ]]
}

save_terms_acceptance() {
  mkdir -p /etc/himosoft
  cat > "${TERMS_FILE}" <<EOF
# Himosoft terms acceptance — $(date -Iseconds)
ACCEPTED_AT="$(date -Iseconds)"
ACCEPTED_TERMS_VERSION="${TERMS_VERSION}"
TERMS_URL="${TERMS_URL}"
PRIVACY_URL="${PRIVACY_URL}"
EOF
  chmod 600 "${TERMS_FILE}"
}

require_terms_acceptance() {
  if terms_already_accepted; then
    return 0
  fi

  print_himosoft_branding

  echo "  Welcome — before setup begins, please review our legal terms."
  echo ""
  echo "  ┌─────────────────────────────────────────────────────────────┐"
  echo "  │  Terms of Service    ${TERMS_URL}"
  echo "  │  Privacy Policy      ${PRIVACY_URL}"
  echo "  └─────────────────────────────────────────────────────────────┘"
  echo ""
  echo "  By continuing you confirm that you:"
  echo "    • Have read and agree to the Terms of Service and Privacy Policy"
  echo "    • Are authorized to install and configure software on this server"
  echo ""
  echo "  Step 0 — Legal agreement"
  echo "  ──────────────────────"

  local reply=""
  read -r -p "  Accept Himosoft Terms and Privacy Policy? [y/N]: " reply
  if [[ ! "${reply}" =~ ^[Yy]$ ]]; then
    echo ""
    echo "  Installation aborted — acceptance is required to continue."
    echo "  Review the documents above and run again when ready:"
    echo "    sudo himosoft-k3s-server install"
    echo ""
    exit 0
  fi

  save_terms_acceptance
  echo ""
  echo "  ✓ Terms accepted — continuing setup."
  echo ""
}

hs_prompt_default() {
  local var_name="$1" question="$2" default="$3"
  local input
  read -r -p "${question} [${default}]: " input
  printf -v "${var_name}" '%s' "${input:-${default}}"
}

hs_prompt_yes_no() {
  local var_name="$1" question="$2" default_yes="${3:-yes}"
  local input prompt_suffix="[y/N]"
  [[ "${default_yes}" == "yes" ]] && prompt_suffix="[Y/n]"
  read -r -p "${question} ${prompt_suffix}: " input
  if [[ -z "${input}" ]]; then
    printf -v "${var_name}" '%s' "$([[ "${default_yes}" == yes ]] && echo yes || echo no)"
  elif [[ "${input}" =~ ^[Yy] ]]; then
    printf -v "${var_name}" '%s' "yes"
  else
    printf -v "${var_name}" '%s' "no"
  fi
}

load_conf() {
  if [[ -f "${CONF}" ]]; then
    # shellcheck source=/dev/null
    source "${CONF}"
  fi
}

save_conf() {
  mkdir -p /etc/himosoft
  cat > "${CONF}" <<EOF
# Himosoft K3s Server — $(date -Iseconds)
PUBLIC_IP="${PUBLIC_IP}"
DOMAIN="${DOMAIN}"
K3S_VERSION="${K3S_VERSION:-}"
ARGOCD_FQDN="${ARGOCD_FQDN:-}"
DASH_FQDN="${DASH_FQDN}"
TRAEFIK_FQDN="${TRAEFIK_FQDN}"
INSTALL_ARGOCD="${INSTALL_ARGOCD:-yes}"
ACME_EMAIL="${ACME_EMAIL:-admin@${DOMAIN}}"
INSTALL_AUTHELIA="${INSTALL_AUTHELIA:-yes}"
AUTH_FQDN="${AUTH_FQDN:-}"
AUTHELIA_ADMIN_USER="${AUTHELIA_ADMIN_USER:-}"
AUTHELIA_ADMIN_EMAIL="${AUTHELIA_ADMIN_EMAIL:-}"
EOF
  chmod 600 "${CONF}"
}

require_share_files() {
  local missing=0 f
  for f in k3s-install.sh platform-bootstrap.sh lib.sh; do
    if [[ ! -f "${SHARE}/${f}" ]]; then
      echo "Missing ${SHARE}/${f} — reinstall: apt install --reinstall himosoft-k3s-server" >&2
      missing=1
    fi
  done
  [[ "${missing}" -eq 0 ]] || exit 1
}

detect_public_ip() {
  # shellcheck source=/dev/null
  source "${SHARE}/lib.sh" 2>/dev/null || true
  if declare -F detect_public_ip >/dev/null 2>&1; then
    detect_public_ip
  else
    curl -fsSL -4 --max-time 5 ifconfig.me 2>/dev/null \
      || curl -fsSL -4 --max-time 5 icanhazip.com 2>/dev/null || true
  fi
}

save_authelia_admin_env() {
  mkdir -p /etc/himosoft
  printf 'AUTHELIA_ADMIN_PASSWORD=%q\n' "${AUTHELIA_ADMIN_PASSWORD}" > /etc/himosoft/authelia-admin.env
  chmod 600 /etc/himosoft/authelia-admin.env
}

prompt_authelia_admin() {
  hs_prompt_default AUTH_FQDN "Authelia login portal hostname" "auth.${DOMAIN}"
  hs_prompt_default AUTHELIA_ADMIN_USER "Authelia admin username" "admin"
  [[ -n "${AUTHELIA_ADMIN_USER}" ]] || { echo "Authelia username is required."; exit 1; }

  local confirm=""
  while true; do
    hs_prompt_secret AUTHELIA_ADMIN_PASSWORD "Authelia admin password"
    [[ -n "${AUTHELIA_ADMIN_PASSWORD}" ]] || { echo "Password is required."; continue; }
    hs_prompt_secret confirm "Confirm Authelia admin password"
    if [[ "${AUTHELIA_ADMIN_PASSWORD}" == "${confirm}" ]]; then
      break
    fi
    echo "Passwords do not match — try again."
  done

  hs_prompt_default AUTHELIA_ADMIN_EMAIL "Authelia account email (label only — no mail server)" "admin@${DOMAIN}"
  [[ -n "${AUTHELIA_ADMIN_EMAIL}" ]] || { echo "Authelia email is required."; exit 1; }
  save_authelia_admin_env
}

# Prompt when Authelia is enabled but admin account was never configured.
prompt_authelia_if_needed() {
  INSTALL_AUTHELIA="${INSTALL_AUTHELIA:-yes}"
  if [[ "${INSTALL_AUTHELIA}" != "yes" ]]; then
    return 0
  fi

  local need=0
  [[ -z "${AUTH_FQDN:-}" ]] && need=1
  [[ -z "${AUTHELIA_ADMIN_USER:-}" ]] && need=1
  [[ -z "${AUTHELIA_ADMIN_EMAIL:-}" ]] && need=1
  [[ ! -f /etc/himosoft/authelia-admin.env ]] && need=1

  if [[ "${need}" -eq 0 ]]; then
    if [[ -z "${AUTHELIA_ADMIN_PASSWORD:-}" && -f /etc/himosoft/authelia-admin.env ]]; then
      # shellcheck source=/dev/null
      source /etc/himosoft/authelia-admin.env
    fi
    return 0
  fi

  echo ""
  echo "Authelia admin account"
  echo "──────────────────────"
  echo "Create the login used to access Argo CD, Dashboard, and Traefik."
  prompt_authelia_admin
  save_conf
}

prompt_install_config() {
  local detected_ip
  detected_ip="$(detect_public_ip | tr -d '[:space:]')"
  [[ -z "${detected_ip}" ]] && detected_ip="unknown"

  echo "Step 1 — Server network"
  echo "────────────────────────"
  hs_prompt_default PUBLIC_IP "Enter server public IPv4" "${detected_ip}"
  [[ "${PUBLIC_IP}" == "unknown" || -z "${PUBLIC_IP}" ]] && { echo "Public IP is required."; exit 1; }

  hs_prompt DOMAIN "Enter base domain (e.g. srv1.himosoft.com.bd)"
  [[ -n "${DOMAIN}" ]] || { echo "Base domain is required."; exit 1; }

  echo ""
  echo "Step 2 — Optional components"
  echo "────────────────────────────"
  hs_prompt_yes_no INSTALL_ARGOCD "Install Argo CD (GitOps UI)?" "yes"

  echo ""
  echo "Step 3 — Authelia SSO (protect web UIs)"
  echo "───────────────────────────────────────"
  hs_prompt_yes_no INSTALL_AUTHELIA "Install Authelia login for Argo CD, Dashboard, and Traefik?" "yes"
  if [[ "${INSTALL_AUTHELIA}" == "yes" ]]; then
    echo ""
    echo "Create your Authelia admin account (login for all protected web UIs):"
    prompt_authelia_admin
  else
    AUTH_FQDN=""
    AUTHELIA_ADMIN_USER=""
    AUTHELIA_ADMIN_EMAIL=""
    rm -f /etc/himosoft/authelia-admin.env
  fi

  echo ""
  echo "Step 4 — Service hostnames (FQDN for each web UI)"
  echo "──────────────────────────────────────────────────"
  echo "Press Enter to accept the default shown in [brackets]."
  echo ""
  if [[ "${INSTALL_ARGOCD}" == "yes" ]]; then
    hs_prompt_default ARGOCD_FQDN "Argo CD hostname" "acd.${DOMAIN}"
  else
    ARGOCD_FQDN=""
  fi
  hs_prompt_default DASH_FQDN "Kubernetes Dashboard hostname" "dash.${DOMAIN}"
  hs_prompt_default TRAEFIK_FQDN "Traefik dashboard hostname" "traefik.${DOMAIN}"

  echo ""
  echo "Step 5 — Let's Encrypt"
  echo "──────────────────────"
  echo "Used for Let's Encrypt registration (cert-manager)."
  hs_prompt_default ACME_EMAIL "Let's Encrypt email" "admin@${DOMAIN}"
  [[ -n "${ACME_EMAIL}" ]] || { echo "Email is required for Let's Encrypt."; exit 1; }

  echo ""
  echo "Step 6 — K3s version (optional)"
  echo "───────────────────────────────"
  hs_prompt_optional K3S_VERSION "K3s version (empty = latest from get.k3s.io)"

  echo ""
  echo "══════════════════════════════════════════════════"
  echo "  Summary"
  echo "══════════════════════════════════════════════════"
  echo "  Public IP              : ${PUBLIC_IP}"
  echo "  Base domain            : ${DOMAIN}"
  echo "  Install Argo CD        : ${INSTALL_ARGOCD}"
  echo "  Authelia SSO           : ${INSTALL_AUTHELIA}"
  if [[ "${INSTALL_AUTHELIA}" == "yes" ]]; then
    echo "  Authelia portal        : https://${AUTH_FQDN}"
    echo "  Authelia admin user    : ${AUTHELIA_ADMIN_USER}"
    echo "  (password — as entered above, not stored in k3s-server.conf)"
  fi
  echo "  Let's Encrypt email    : ${ACME_EMAIL}"
  echo ""
  if [[ "${INSTALL_ARGOCD}" == "yes" ]]; then
    echo "  Argo CD                : https://${ARGOCD_FQDN}"
  fi
  echo "  Kubernetes Dashboard   : https://${DASH_FQDN}"
  echo "  Traefik Dashboard      : https://${TRAEFIK_FQDN}/dashboard/"
  echo ""
  echo "  K3s version            : ${K3S_VERSION:-latest}"
  echo "  SSL                    : cert-manager + Let's Encrypt if DNS points to ${PUBLIC_IP}"
  echo ""
  echo "  DNS — create A records → ${PUBLIC_IP}:"
  if [[ "${INSTALL_AUTHELIA}" == "yes" ]]; then
    echo "    ${AUTH_FQDN}"
  fi
  if [[ "${INSTALL_ARGOCD}" == "yes" ]]; then
    echo "    ${ARGOCD_FQDN}"
  fi
  echo "    ${DASH_FQDN}"
  echo "    ${TRAEFIK_FQDN}"
  echo "══════════════════════════════════════════════════"
  echo ""
}

hs_confirm_yes() {
  local question="$1"
  local reply
  read -r -p "${question} [Y/n]: " reply
  [[ -z "${reply}" || "${reply}" =~ ^[Yy]$ ]]
}

save_config_baselines() {
  BASE_PUBLIC_IP="${PUBLIC_IP:-}"
  BASE_DOMAIN="${DOMAIN:-}"
  BASE_K3S_VERSION="${K3S_VERSION:-}"
  BASE_ARGOCD_FQDN="${ARGOCD_FQDN:-}"
  BASE_DASH_FQDN="${DASH_FQDN:-}"
  BASE_TRAEFIK_FQDN="${TRAEFIK_FQDN:-}"
  BASE_AUTH_FQDN="${AUTH_FQDN:-}"
  BASE_INSTALL_ARGOCD="${INSTALL_ARGOCD:-yes}"
  BASE_INSTALL_AUTHELIA="${INSTALL_AUTHELIA:-yes}"
  BASE_ACME_EMAIL="${ACME_EMAIL:-}"
  BASE_AUTHELIA_ADMIN_USER="${AUTHELIA_ADMIN_USER:-}"
  BASE_AUTHELIA_ADMIN_EMAIL="${AUTHELIA_ADMIN_EMAIL:-}"
}

detect_config_changes() {
  CONFIG_K3S_CHANGED=no
  CONFIG_TRAEFIK_CHANGED=no
  CONFIG_AUTHELIA_CHANGED=no
  CONFIG_ARGOCD_CHANGED=no
  CONFIG_DASHBOARD_CHANGED=no
  CONFIG_INGRESS_CHANGED=no

  if [[ "${BASE_PUBLIC_IP}" != "${PUBLIC_IP}" || "${BASE_DOMAIN}" != "${DOMAIN}" \
     || "${BASE_K3S_VERSION}" != "${K3S_VERSION:-}" ]]; then
    CONFIG_K3S_CHANGED=yes
  fi
  if [[ "${BASE_TRAEFIK_FQDN}" != "${TRAEFIK_FQDN}" || "${BASE_ACME_EMAIL}" != "${ACME_EMAIL}" ]]; then
    CONFIG_TRAEFIK_CHANGED=yes
  fi
  if [[ "${BASE_AUTH_FQDN}" != "${AUTH_FQDN:-}" || "${BASE_INSTALL_AUTHELIA}" != "${INSTALL_AUTHELIA}" \
     || "${BASE_AUTHELIA_ADMIN_USER}" != "${AUTHELIA_ADMIN_USER:-}" \
     || "${BASE_AUTHELIA_ADMIN_EMAIL}" != "${AUTHELIA_ADMIN_EMAIL:-}" ]]; then
    CONFIG_AUTHELIA_CHANGED=yes
  fi
  if [[ "${BASE_ARGOCD_FQDN}" != "${ARGOCD_FQDN:-}" || "${BASE_INSTALL_ARGOCD}" != "${INSTALL_ARGOCD}" ]]; then
    CONFIG_ARGOCD_CHANGED=yes
  fi
  if [[ "${BASE_DASH_FQDN}" != "${DASH_FQDN}" ]]; then
    CONFIG_DASHBOARD_CHANGED=yes
  fi
  if [[ "${CONFIG_TRAEFIK_CHANGED}" == yes || "${CONFIG_AUTHELIA_CHANGED}" == yes \
     || "${CONFIG_ARGOCD_CHANGED}" == yes || "${CONFIG_DASHBOARD_CHANGED}" == yes ]]; then
    CONFIG_INGRESS_CHANGED=yes
  fi
}

installation_detected() {
  [[ -f "${CONF}" ]] && return 0
  # shellcheck source=/dev/null
  source "${SHARE}/lib.sh" 2>/dev/null || true
  k3s_running 2>/dev/null
}

print_platform_status() {
  local traefik_state="${STATE_TRAEFIK}" authelia_state="${STATE_AUTHELIA}"
  local argocd_state="${STATE_ARGOCD}" dashboard_state="${STATE_DASHBOARD}"

  [[ "${INSTALL_AUTHELIA:-yes}" != "yes" ]] && authelia_state=disabled
  [[ "${INSTALL_ARGOCD:-yes}" != "yes" ]] && argocd_state=disabled

  echo "  K3s                  : $(platform_state_label "${STATE_K3S}")"
  echo "  Traefik              : $(platform_state_label "${traefik_state}")"
  echo "  cert-manager         : $(platform_state_label "${STATE_CERT_MANAGER:-missing}")"
  echo "  Authelia             : $(platform_state_label "${authelia_state}")"
  echo "  Argo CD              : $(platform_state_label "${argocd_state}")"
  echo "  Kubernetes Dashboard : $(platform_state_label "${dashboard_state}")"
  [[ -f "${CONF}" ]] && echo "  Saved config         : ${CONF}"
}

plan_action_label() {
  local state="$1" skip="$2" reconfigure="${3:-no}"
  if [[ "${skip}" == "yes" ]]; then
    if [[ "${reconfigure}" == "yes" ]]; then
      echo "reconfigure ingress only"
    else
      echo "skip"
    fi
  elif [[ "${state}" == "ready" ]]; then
    echo "reconfigure"
  elif [[ "${state}" == "installed" ]]; then
    echo "continue / finish"
  else
    echo "install"
  fi
}

print_install_plan() {
  local authelia_state="${STATE_AUTHELIA}" argocd_state="${STATE_ARGOCD}"
  [[ "${INSTALL_AUTHELIA:-yes}" != "yes" ]] && authelia_state=disabled
  [[ "${INSTALL_ARGOCD:-yes}" != "yes" ]] && argocd_state=disabled

  echo ""
  echo "Installation plan"
  echo "─────────────────"
  printf "  %-22s : %s\n" "K3s" "$(plan_action_label "${STATE_K3S}" "${SKIP_K3S}")"
  printf "  %-22s : %s\n" "Traefik" "$(plan_action_label "${STATE_TRAEFIK}" "${SKIP_TRAEFIK}")"
  printf "  %-22s : %s\n" "Authelia" "$(plan_action_label "${authelia_state}" "${SKIP_AUTHELIA}")"
  printf "  %-22s : %s\n" "Argo CD" "$(plan_action_label "${argocd_state}" "${SKIP_ARGOCD}" "${RECONFIGURE_ARGOCD:-no}")"
  printf "  %-22s : %s\n" "Dashboard" "$(plan_action_label "${STATE_DASHBOARD}" "${SKIP_DASHBOARD}" "${RECONFIGURE_DASHBOARD:-no}")"
  if [[ "${SKIP_INGRESS:-no}" == "yes" ]]; then
    printf "  %-22s : %s\n" "Ingress routes" "skip"
  else
    printf "  %-22s : %s\n" "Ingress routes" "apply"
  fi
  echo ""
}

plan_install_actions() {
  SKIP_K3S=no
  SKIP_TRAEFIK=no
  SKIP_AUTHELIA=no
  SKIP_ARGOCD=no
  SKIP_DASHBOARD=no
  SKIP_INGRESS=no
  RECONFIGURE_ARGOCD=no
  RECONFIGURE_DASHBOARD=no
  RECONFIGURE_AUTHELIA=no

  if [[ "${STATE_K3S}" == "ready" ]]; then
    SKIP_K3S=yes
    if [[ "${CONFIG_K3S_CHANGED:-no}" == "yes" ]]; then
      echo ""
      echo "Note: K3s is already running. IP/domain changes in config were saved but"
      echo "      K3s TLS settings are not changed automatically (avoids cluster restart)."
    fi
  fi

  if [[ "${STATE_TRAEFIK}" == "ready" ]]; then
    if [[ "${CONFIG_TRAEFIK_CHANGED:-no}" == "yes" ]]; then
      echo ""
      echo "Traefik is installed but hostname or Let's Encrypt email changed."
      if hs_confirm "Reconfigure Traefik (Helm upgrade)?"; then
        SKIP_TRAEFIK=no
      else
        SKIP_TRAEFIK=yes
      fi
    else
      SKIP_TRAEFIK=yes
    fi
  fi

  if [[ "${INSTALL_AUTHELIA:-yes}" != "yes" || -z "${AUTH_FQDN:-}" ]]; then
    SKIP_AUTHELIA=yes
  elif [[ "${STATE_AUTHELIA}" == "ready" ]]; then
    if [[ "${CONFIG_AUTHELIA_CHANGED:-no}" == "yes" ]]; then
      echo ""
      echo "Authelia is installed but portal hostname or enable/disable setting changed."
      if hs_confirm "Reconfigure Authelia?"; then
        SKIP_AUTHELIA=no
        RECONFIGURE_AUTHELIA=yes
      else
        SKIP_AUTHELIA=yes
      fi
    else
      SKIP_AUTHELIA=yes
    fi
  fi

  if [[ "${INSTALL_ARGOCD:-yes}" != "yes" || -z "${ARGOCD_FQDN:-}" ]]; then
    SKIP_ARGOCD=yes
  elif [[ "${STATE_ARGOCD}" == "ready" ]]; then
    if [[ "${CONFIG_ARGOCD_CHANGED:-no}" == "yes" ]]; then
      echo ""
      echo "Argo CD is installed but hostname changed."
      if hs_confirm "Reconfigure Argo CD ingress?"; then
        SKIP_ARGOCD=yes
        RECONFIGURE_ARGOCD=yes
      else
        SKIP_ARGOCD=yes
      fi
    else
      SKIP_ARGOCD=yes
    fi
  fi

  if [[ "${STATE_DASHBOARD}" == "ready" ]]; then
    if [[ "${CONFIG_DASHBOARD_CHANGED:-no}" == "yes" ]]; then
      echo ""
      echo "Kubernetes Dashboard is installed but hostname changed."
      if hs_confirm "Reconfigure Dashboard ingress?"; then
        SKIP_DASHBOARD=yes
        RECONFIGURE_DASHBOARD=yes
      else
        SKIP_DASHBOARD=yes
      fi
    else
      SKIP_DASHBOARD=yes
    fi
  fi

  if [[ "${CONFIG_INGRESS_CHANGED:-no}" == yes || "${RECONFIGURE_ARGOCD:-no}" == yes \
     || "${RECONFIGURE_DASHBOARD:-no}" == yes || "${RECONFIGURE_AUTHELIA:-no}" == yes ]]; then
    SKIP_INGRESS=no
  elif [[ "${SKIP_TRAEFIK}" == yes && "${SKIP_AUTHELIA}" == yes && "${SKIP_ARGOCD}" == yes \
       && "${SKIP_DASHBOARD}" == yes ]]; then
    SKIP_INGRESS=yes
  fi

  export SKIP_K3S SKIP_TRAEFIK SKIP_AUTHELIA SKIP_ARGOCD SKIP_DASHBOARD SKIP_INGRESS
  export RECONFIGURE_ARGOCD RECONFIGURE_DASHBOARD RECONFIGURE_AUTHELIA
}

prepare_smart_install() {
  # shellcheck source=/dev/null
  source "${SHARE}/lib.sh"
  detect_platform_state

  echo ""
  echo "Existing installation detected"
  echo "──────────────────────────────"
  print_platform_status

  if [[ -f "${CONF}" ]]; then
    if hs_confirm_yes "Use saved configuration from ${CONF}?"; then
      prompt_authelia_if_needed
    else
      prompt_install_config
    fi
  else
    prompt_install_config
  fi

  detect_config_changes
  plan_install_actions
  print_install_plan

  hs_confirm_yes "Proceed with this plan?" || { echo "Aborted."; exit 0; }
  save_conf
}

prepare_fresh_install() {
  prompt_install_config
  CONFIG_K3S_CHANGED=no
  CONFIG_TRAEFIK_CHANGED=no
  CONFIG_AUTHELIA_CHANGED=no
  CONFIG_ARGOCD_CHANGED=no
  CONFIG_DASHBOARD_CHANGED=no
  CONFIG_INGRESS_CHANGED=no
  # shellcheck source=/dev/null
  source "${SHARE}/lib.sh"
  detect_platform_state
  plan_install_actions
  print_install_plan
  hs_confirm_yes "Proceed with installation?" || { echo "Aborted."; exit 0; }
  save_conf
}

export_install_vars() {
  export PUBLIC_IP DOMAIN K3S_VERSION ARGOCD_FQDN DASH_FQDN TRAEFIK_FQDN
  export INSTALL_ARGOCD INSTALL_AUTHELIA AUTH_FQDN ACME_EMAIL SHARE
  export AUTHELIA_ADMIN_USER AUTHELIA_ADMIN_EMAIL AUTHELIA_ADMIN_PASSWORD
  export SKIP_K3S SKIP_TRAEFIK SKIP_AUTHELIA SKIP_ARGOCD SKIP_DASHBOARD SKIP_INGRESS
  export RECONFIGURE_ARGOCD RECONFIGURE_DASHBOARD RECONFIGURE_AUTHELIA
  if [[ -z "${AUTHELIA_ADMIN_PASSWORD:-}" && -f /etc/himosoft/authelia-admin.env ]]; then
    # shellcheck source=/dev/null
    source /etc/himosoft/authelia-admin.env
    export AUTHELIA_ADMIN_PASSWORD
  fi
}

cmd_install() {
  hs_require_root
  require_share_files
  require_terms_acceptance

  if installation_detected; then
    load_conf 2>/dev/null || true
    save_config_baselines
    prepare_smart_install
  else
    prepare_fresh_install
  fi

  export_install_vars
  exec "${SHARE}/k3s-install.sh"
}

cmd_bootstrap() {
  hs_require_root
  require_share_files
  require_terms_acceptance

  if ! command -v k3s >/dev/null 2>&1 || ! systemctl is-active k3s &>/dev/null; then
    echo "K3s is not running. Run: sudo himosoft-k3s-server install"
    exit 1
  fi

  load_conf 2>/dev/null || true
  save_config_baselines

  if [[ -f "${CONF}" ]]; then
    prepare_smart_install
  else
    prepare_fresh_install
  fi

  export_install_vars
  exec "${SHARE}/platform-bootstrap.sh"
}

cmd_status() {
  load_conf 2>/dev/null || true
  echo "=== Himosoft K3s Server ==="
  if [[ -f "${CONF}" ]]; then
    cat "${CONF}"
    echo ""
    echo "URLs:"
    [[ "${INSTALL_ARGOCD:-yes}" == "yes" && -n "${ARGOCD_FQDN:-}" ]] && \
      echo "  Argo CD              : https://${ARGOCD_FQDN}"
    echo "  Kubernetes Dashboard : https://${DASH_FQDN:-?}"
    echo "  Traefik Dashboard    : https://${TRAEFIK_FQDN:-?}/dashboard/"
    echo ""
  else
    echo "Not configured. Run: sudo himosoft-k3s-server install"
  fi
  if command -v k3s >/dev/null 2>&1 && systemctl is-active k3s &>/dev/null; then
    k3s kubectl get nodes 2>/dev/null
    echo ""
    k3s kubectl get pods -n traefik 2>/dev/null || true
    k3s kubectl get pods -n cert-manager 2>/dev/null || true
    k3s kubectl get certificate -A 2>/dev/null || true
    k3s kubectl get pods -n argocd 2>/dev/null || true
    k3s kubectl get pods -n kubernetes-dashboard 2>/dev/null || true
  fi
}

cmd_credentials() {
  hs_require_root
  load_conf 2>/dev/null || true
  echo "=== Credentials ==="
  if [[ "${INSTALL_AUTHELIA:-yes}" == "yes" && -n "${AUTH_FQDN:-}" ]]; then
    echo "Authelia — https://${AUTH_FQDN}"
    echo "  Username: ${AUTHELIA_ADMIN_USER:-admin}"
    echo "  Use the password you set at install (password-only login; TOTP disabled)"
    echo "  Manage users: sudo himosoft-k3s-server authelia help"
    echo "  Authelia codes (filesystem notifier, no SMTP):"
    echo "    sudo k3s kubectl exec -n authelia deploy/authelia -- cat /data/notification.txt"
    echo ""
  fi
  if [[ "${INSTALL_ARGOCD:-yes}" == "yes" ]] && \
     k3s kubectl get secret argocd-initial-admin-secret -n argocd >/dev/null 2>&1; then
    echo "Argo CD — https://${ARGOCD_FQDN:-acd.<domain>}"
    echo "  Username: admin"
    echo -n "  Password: "
    k3s kubectl get secret argocd-initial-admin-secret -n argocd \
      -o jsonpath='{.data.password}' | base64 -d
    echo ""
    echo ""
  fi
  if k3s kubectl get sa himosoft-dashboard-admin -n kubernetes-dashboard >/dev/null 2>&1; then
    echo "Kubernetes Dashboard — https://${DASH_FQDN:-dash.<domain>}"
    echo "  Token:"
    k3s kubectl -n kubernetes-dashboard create token himosoft-dashboard-admin --duration=8760h
    echo ""
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  case "$1" in
    install|configure) cmd_install ;;
    bootstrap) cmd_bootstrap ;;
    status) cmd_status ;;
    credentials) cmd_credentials ;;
    authelia) cmd_authelia "$@" ;;
    help|-h|--help) usage ;;
    *) echo "Unknown command: $1" >&2; echo "" >&2; usage; exit 1 ;;
  esac
}

main "$@"
