#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /etc/himosoft
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  Himosoft K3s Server installed                               ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "Package installed — cluster NOT set up yet."
    echo ""
    echo "When ready, run the interactive installer:"
    echo ""
    echo "  sudo himosoft-k3s-server install"
    echo ""
    echo "Other commands:"
    echo "  sudo himosoft-k3s-server help          — usage and options"
    echo "  sudo himosoft-k3s-server bootstrap     — platform only (K3s must run)"
    echo "  sudo himosoft-k3s-server status        — cluster health"
    echo "  sudo himosoft-k3s-server credentials   — passwords and tokens"
    echo ""
    ;;
esac

#DEBHELPER#

exit 0
