#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /etc/himosoft
    echo ""
    echo "Himosoft K3s Server installed."
    echo ""
    echo "  sudo himosoft-k3s-server install       # K3s + Traefik + Argo CD + dashboards"
    echo "  sudo himosoft-k3s-server bootstrap     # platform only (K3s already running)"
    echo "  sudo himosoft-k3s-server status"
    echo "  sudo himosoft-k3s-server credentials"
    echo ""
    ;;
esac

#DEBHELPER#

exit 0
