#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /etc/himosoft
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  Himosoft K3s Server installed                               ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "Package installed — cluster NOT set up yet."
    echo ""
    echo "Run the interactive installer (prompts for IP, domain, hostnames):"
    echo ""
    echo "  sudo himosoft-k3s-server install"
    echo "  sudo himosoft-k3s-server          # same as install"
    echo ""
    echo "You will be asked for:"
    echo "  • Server public IP"
    echo "  • Base domain (e.g. srv1.himosoft.com.bd)"
    echo "  • Argo CD hostname         (default: acd.<domain>)"
    echo "  • Kubernetes Dashboard     (default: dash.<domain>)"
    echo "  • Traefik dashboard        (default: traefik.<domain>)"
    echo ""
    echo "After setup, access:"
    echo "  https://acd.<your-domain>              — Argo CD"
    echo "  https://dash.<your-domain>             — Kubernetes Dashboard"
    echo "  https://traefik.<your-domain>/dashboard/ — Traefik"
    echo ""
    echo "  sudo himosoft-k3s-server credentials   — passwords & tokens"
    echo "  sudo himosoft-k3s-server status         — check cluster"
    echo ""

    if [ ! -f /etc/himosoft/k3s-server.conf ] && [ -t 0 ] && [ -t 1 ]; then
      printf "Run interactive setup now? [y/N]: "
      read -r reply
      case "$reply" in
        y|Y|yes|Yes|YES)
          echo ""
          himosoft-k3s-server install
          ;;
      esac
    fi
    ;;
esac

#DEBHELPER#

exit 0
