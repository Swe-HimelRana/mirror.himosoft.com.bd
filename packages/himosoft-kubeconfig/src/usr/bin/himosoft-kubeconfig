#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source /usr/share/himosoft/lib/interactive.sh

K3S_KUBECONFIG="/etc/rancher/k3s/k3s.yaml"

usage() {
  cat <<'EOF'
Himosoft Kubeconfig

Usage:
  himosoft-kubeconfig export    Write kubeconfig with your chosen server address
  himosoft-kubeconfig help
EOF
}

cmd_export() {
  hs_require_root
  [[ -f "${K3S_KUBECONFIG}" ]] || { echo "K3s kubeconfig not found. Install K3s first."; exit 1; }

  hs_banner "Kubeconfig export"

  hs_prompt SERVER_ADDRESS "Enter server address for kubeconfig (public IP or DNS)"
  [[ -n "${SERVER_ADDRESS}" ]] || exit 1

  hs_prompt OUTPUT_PATH "Enter output file path"
  [[ -n "${OUTPUT_PATH}" ]] || exit 1

  echo ""
  echo "Will replace 127.0.0.1 with: ${SERVER_ADDRESS}"
  echo "Output file: ${OUTPUT_PATH}"
  hs_confirm "Proceed?" || exit 0

  sed "s/127.0.0.1/${SERVER_ADDRESS}/g" "${K3S_KUBECONFIG}" > "${OUTPUT_PATH}"
  chmod 600 "${OUTPUT_PATH}"
  echo "Written: ${OUTPUT_PATH}"
  echo "Use with: kubectl --kubeconfig ${OUTPUT_PATH} get nodes"
}

main() {
  case "${1:-export}" in
    export) cmd_export ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
